# Leave everything blank and `npm start` replays the recorded books of a
# fictional coffee roaster with Claude's recorded decisions. Fill in only
# ANTHROPIC_API_KEY and Claude judges those recorded books live.

# Your One API key. After `one init`, find it in ~/.one/config.json (apiKey)
# or in the dashboard at https://app.withone.ai
ONE_SECRET=

# Your Anthropic API key (https://platform.claude.com)
ANTHROPIC_API_KEY=

# The QuickBooks connection key from `one --agent connection list`
ONE_CONNECTION_QUICKBOOKS=

# Your QuickBooks Online company ID (the realmId in your QuickBooks URL)
QUICKBOOKS_REALM_ID=

# Optional: post the brief to a Slack channel. Both lines or neither.
# ONE_CONNECTION_SLACK=
# SLACK_CHANNEL=#ap

# Optional: the arithmetic that decides what gets flagged.
# What a flag means is in config/ap-policy.md.
# LOOKBACK_MONTHS=12       how much bill history to read
# PRICE_CREEP_PCT=3        unit price rise on the vendor's last bill that flags
# NEAR_DUPLICATE_DAYS=10   same vendor and total within this many days flags
# NO_PO_OVER=5000          a first bill from a new vendor above this with no PO flags
# OVER_PO_PCT=1            billed against a PO by more than this % over its total flags

# Optional: override the Claude model (default claude-opus-5-5)
# CLAUDE_MODEL=claude-opus-5-5
